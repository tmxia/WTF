<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/slight_light_gray"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/code_toolbar"
        style="@style/Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/white"
        app:title="代码详情"
        app:titleTextColor="@color/black">

        <!-- 自定义右上角的复制按钮，带 Ripple 按压效果 -->
        <ImageView
            android:id="@+id/btn_copy_code"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:contentDescription="复制代码"
            android:padding="12dp"
            app:srcCompat="@drawable/ic_copy_white_24dp"
            app:tint="@color/black" />

    </com.google.android.material.appbar.MaterialToolbar>

    <WebView
        android:id="@+id/webview_code"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/slight_light_gray" />

</LinearLayout>
