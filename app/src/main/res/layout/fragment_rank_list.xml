<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout android:layout_marginTop="@dimen/dp_12"
    android:layout_width="match_parent"
        
        
        android:clipToPadding="false"
    android:layout_height="wrap_content"
    
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <TextView
        android:id="@+id/rank_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/rank_list_today_heat_title"
        android:textSize="@dimen/sp_14"
        android:textStyle="normal"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="@dimen/dp_8"
        android:layout_marginTop="@dimen/dp_4"
        android:layout_marginStart="0dp"
        android:textColor="@color/red_dark2" />

    <TextView
        android:id="@+id/rank_tips"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="update time"
        android:textSize="@dimen/sp_10"
        android:layout_marginTop="@dimen/dp_2"
        android:layout_marginStart="0dp"
        android:layout_below="@id/rank_recycler_view"
        android:layout_alignParentStart="true"
        android:textColor="@color/gray" />
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rank_recycler_view"
        android:layout_below="@id/rank_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</RelativeLayout>