<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:layout_marginBottom="0dp"
    
    
    app:cardCornerRadius="8dp"
    app:cardElevation="0dp"
    app:cardBackgroundColor="@color/white">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/article_container"
    android:layout_width="match_parent"
        
        
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_marginBottom="@dimen/dp_1"
    android:paddingBottom="@dimen/dp_6">

    <!--
    标题左外边距给 dp_9（与原版一致），让排名 emoji（index ImageView，dp_16）
    覆盖标题首字符——这是原作者的视觉风格：emoji 往前压一点儿，和文字"咬合"。
    字号 sp_13（在 sp_12 偏小和 sp_14 偏大之间取中）。
    -->
    <TextView
        android:id="@+id/title_text_view"
        style="@style/TextStyle.Heading"
        android:textStyle="normal"
        android:fontFamily="sans-serif-medium"
        android:layout_width="@dimen/dp_0"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dp_7"
        android:layout_marginEnd="@dimen/dp_8"
        android:maxLines="2"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="Title"/>

    <TextView
        android:id="@+id/num"
        style="@style/TextStyle.Title.Sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginStart="0dp"
        android:minEms="4"
        android:gravity="start"
        app:layout_constraintTop_toTopOf="@id/forum"
        app:layout_constraintEnd_toEndOf="@id/title_text_view"
        android:textColor="@color/red_dark2"
        tools:text="热度:233"/>

    <TextView
        android:id="@+id/forum"
        style="@style/TextStyle.Title.Sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="middle"
        android:maxWidth="@dimen/dp_200"
        android:singleLine="true"
        android:layout_marginTop="@dimen/dp_4"
        app:layout_constraintTop_toBottomOf="@id/title_text_view"
        app:layout_constraintStart_toStartOf="@id/title_text_view"
        tools:text="『原创发布区』"/>

    <TextView
        android:id="@+id/index"
        android:layout_width="24dp"
        android:layout_height="24dp" android:layout_marginStart="0dp"
        android:gravity="center"
        android:textStyle="normal"
        android:fontFamily="sans-serif-medium"
        android:textSize="16sp"
        android:textColor="#FF5722"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/title_text_view"
        app:layout_constraintBottom_toBottomOf="@id/title_text_view"
        android:contentDescription="@null" />

</androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
